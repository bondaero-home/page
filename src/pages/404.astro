---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/site/SiteHeader.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import { business } from '../data/business';
---
<BaseLayout title="페이지를 찾을 수 없어요 (404) | 본대로홈" noindex={true}>
  <SiteHeader />
  <main id="main">
    <section class="sec" style="text-align:center;padding:140px 0 120px">
      <div class="container">
        <p class="eyebrow">404</p>
        <h1 class="h2">페이지를 찾을 수 없어요</h1>
        <p style="margin:20px auto 0;max-width:520px">주소가 바뀌었거나 삭제된 페이지일 수 있어요.<br />아래에서 원하시는 곳으로 이동해 보세요.</p>
        <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap;margin-top:34px">
          <a class="btn btn-primary" href="/">메인으로</a>
          <a class="btn btn-line" href="/블로그">블로그 보기</a>
          <a class="btn btn-line" href="/문의">문의하기</a>
        </div>
        <p style="margin-top:28px;font-size:14px;color:var(--muted)">바로 상담을 원하시면 <a href={`tel:${business.phone}`} style="color:var(--primary);font-weight:700">{business.phone}</a></p>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
