---
import { getCollection } from 'astro:content';
import BlogList from '../../../layouts/BlogList.astro';
import BlogCard from '../../../components/site/BlogCard.astro';

export async function getStaticPaths() {
  const all = (await getCollection('blog')).filter((p) => !p.data.draft);
  const tags = [...new Set(all.flatMap((p) => p.data.tags))];
  return tags.map((tag) => ({
    params: { tag },
    props: {
      tag,
      posts: all
        .filter((p) => p.data.tags.includes(tag))
        .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()),
    },
  }));
}

const { tag, posts } = Astro.props;
---
<BlogList
  metaTitle={`#${tag} — 청주 오창 커튼·블라인드 | 본대로홈`}
  metaDescription={`'${tag}' 태그 글 모음. 청주 오창·오송 커튼·블라인드 본대로홈 블로그.`}
  eyebrow="Tag"
  heading={`#${tag}`}
  lead={`'${tag}' 태그 글 ${posts.length}편`}
  crumb={`#${tag}`}
>
  <div class="bcards">
    {posts.map((p) => <BlogCard post={p} />)}
  </div>
</BlogList>
