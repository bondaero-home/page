---
import { getCollection } from 'astro:content';
import BlogListShell from '../../../layouts/BlogListShell.astro';
import PostGrid from '../../../components/blog/PostGrid.astro';

export async function getStaticPaths() {
  const all = (await getCollection('blog')).filter((p) => !p.data.draft);
  const tags = [...new Set(all.flatMap((p) => p.data.tags))];
  return tags.map((tag) => ({
    params: { tag },
    props: {
      tag,
      posts: all
        .filter((p) => p.data.tags.includes(tag))
        .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()),
    },
  }));
}

const { tag, posts } = Astro.props;
---
<BlogListShell
  metaTitle={`#${tag} — 청주 오창 커튼·블라인드 | 본대로홈`}
  metaDescription={`'${tag}' 태그 글 모음. 청주 오창·오송 커튼·블라인드 본대로홈 블로그.`}
  eyebrow="블로그 · 태그"
  heading={`#${tag}`}
  lead={`'${tag}' 태그 글 ${posts.length}편`}
>
  <PostGrid posts={posts} />
</BlogListShell>
