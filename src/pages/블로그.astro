---
// 블로그 목록 — 디자인 v3 (2026-11). 가장 최근 시공사례를 위에 크게, 나머지는 카드. #cases 로 들어오면 시공사례만.
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BlogList from '../layouts/BlogList.astro';
import BlogCard from '../components/site/BlogCard.astro';

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
const feat = posts.find((p) => p.data.category === '시공사례');
const rest = posts.filter((p) => p !== feat);
const count = (c: string) => posts.filter((p) => p.data.category === c).length;
const ARROW = '<svg class="arrow" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M1 8h13M9 3l5 5-5 5"/></svg>';
---
<BlogList
  metaTitle="블로그 — 청주 오창 커튼·블라인드 시공 사례 | 본대로홈"
  metaDescription="청주 오창·오송 실제 커튼·블라인드 시공 사례와 제품 선택 가이드. 우리 집 창과 비슷한 사례를 찾아보세요."
  heading="커튼·블라인드<br>이야기"
  lead="시공 사례와 고르는 법, 관리법까지. 매장에서 자주 받는 질문을 글로 정리했어요."
>
  <div class="chips" style="justify-content:center">
    <button type="button" class="chip on" data-filter="all">전체 {posts.length}</button>
    <button type="button" class="chip" data-filter="가이드">가이드 {count('가이드')}</button>
    <button type="button" class="chip" data-filter="시공사례">시공사례 {count('시공사례')}</button>
  </div>

  {feat && (
    <a class="feat" data-cat="시공사례" href={`/블로그/${feat.id}`}>
      <div class="im"><Image src={feat.data.heroImage} alt={feat.data.heroImageAlt} width={1200} height={800} /></div>
      <div class="tx">
        <div class="pills">
          <span class="pill cat">시공사례</span>
          {feat.data.product && <span class="pill">{feat.data.product}</span>}
          {feat.data.buildingType && <span class="pill soft">{feat.data.buildingType}</span>}
        </div>
        <h2>{feat.data.title}</h2>
        <p>{feat.data.description}</p>
        <div class="igrid">
          {feat.data.location && <div><span>지역</span><b>{feat.data.location}</b></div>}
          {feat.data.buildingType && <div><span>공간</span><b>{feat.data.buildingType}{feat.data.area ? ` · ${feat.data.area}` : ''}</b></div>}
          {feat.data.product && <div><span>제품</span><b>{feat.data.product}</b></div>}
          {feat.data.cost && <div><span>비용</span><b>{feat.data.cost}</b></div>}
        </div>
        <span class="go">사례 자세히 보기 <Fragment set:html={ARROW} /></span>
      </div>
    </a>
  )}

  <div class="bcards">
    {rest.map((p) => <BlogCard post={p} />)}
  </div>
</BlogList>
