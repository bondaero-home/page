---
import BaseLayout from '../layouts/BaseLayout.astro';
import PromoBanner from '../components/PromoBanner.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileFloatingCall from '../components/MobileFloatingCall.astro';
import FinalCTA from '../components/FinalCTA.astro';
import FaqIntro from '../components/faq/FaqIntro.astro';
import CategoryNav from '../components/faq/CategoryNav.astro';
import CategoryBlock from '../components/faq/CategoryBlock.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import { css } from '../lib/css';
import { CATEGORIES } from '../data/faq';

const title = '자주 묻는 질문 — 커튼·블라인드 | 본대로홈 (청주 오창)';
const description =
  '커튼 가격대, 방문 실측, 제작 기간, 발주 취소, 커튼 vs 블라인드, A/S까지. 청주 오창 맞춤 커튼 전문점이 자주 묻는 질문에 답해드려요.';

// ── JSON-LD ──────────────────────────────────────────────
// 답변(a)은 내부 링크가 섞인 HTML 문자열이다. FAQPage의 answer가 허용하는 태그는
// 제한적이고 style 속성은 그 목록에 없어서, 마크업을 걷어내고 본문만 넘긴다.
const toPlainText = (html: string) =>
  html
    .replace(/<[^>]+>/g, '')
    .replace(/&nbsp;/g, ' ')
    .replace(/&amp;/g, '&')
    .replace(/&lt;/g, '<')
    .replace(/&gt;/g, '>')
    .replace(/&quot;/g, '"')
    .replace(/&#39;/g, "'")
    .replace(/\s+/g, ' ')
    .trim();

const faqPage = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': `${(Astro.site ?? new URL('https://bondaerohome.com')).origin}/FAQ#faq`,
  inLanguage: 'ko-KR',
  mainEntity: CATEGORIES.flatMap((c) =>
    c.items.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: toPlainText(item.a) },
    }))
  ),
};
---
<BaseLayout title={title} description={description}>
  <Fragment slot="head">
    <JsonLd schema={faqPage} />
  </Fragment>

  <PromoBanner />
  <Header />
  <main>
    <FaqIntro />
    <section class="block" style={css({ paddingTop: 64 })}>
      <div class="container" style={css({ maxWidth: 820 })}>
        <CategoryNav />
        {CATEGORIES.map((c, i) => (
          <CategoryBlock cat={c} startOpen={i === 0} />
        ))}
      </div>
    </section>
    <FinalCTA
      titleHtml="여기 없는 질문은,<br />전화 한 통이면 됩니다"
      leadHtml="궁금한 게 더 있으시면 편하게 전화 주세요. 진행 방법과 대략적인 가격대를 바로 알려드려요.<br />청주·오창·오송 방문 실측 무료입니다."
      primaryLabel="지금 전화 상담하기"
      secondaryLabel="매장 방문하기"
    />
  </main>
  <Footer />
  <MobileFloatingCall />
</BaseLayout>
