---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/site/SiteHeader.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import { business } from '../data/business';

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);
const dot = (d: Date) => `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;

const ARROW = '<svg class="arrow" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M1 8h13M9 3l5 5-5 5"/></svg>';
const POSTER = '/images/hero-poster-v20-straightened-opening.jpg';
const VIDEO = '/videos/hero-v24-natural-sewing.mp4';

const steps = [
  { h: '매장 방문 또는<br>전화 문의', d: '원하시는 공간과 제품을 편하게 말씀해 주세요', img: 'process-store-interior-v5.webp' },
  { h: '샘플 확인·<br>상품 결정', d: '매장에서 원단을 직접 보고 결정하실 수 있습니다', img: 'process-fabric-sample-v2.webp' },
  { h: '방문<br>실측', d: '창문 방향과 인테리어 색감까지 함께 보며 조율합니다', img: 'process-measure-v3.webp' },
  { h: '사이즈 측정·<br>발주', d: '정확한 사이즈 측정 후 공장에 발주합니다', img: 'process-order-fabric-v2.webp' },
  { h: '맞춤<br>제작', d: '발주 후 약 1주일 내 제작 완료', img: 'process-sewing-factory.webp' },
  { h: '설치', d: '약속된 날짜에 방문해 설치해 드립니다', img: 'process-install-curtain-v4.webp' },
];
const services = [
  { id: 'blackout', t: '암막커튼', d: '빛을 완벽히 차단해 깊은 잠을 돕습니다', s: '침실 · 안방', img: 'service-blackout-v2.webp' },
  { id: 'sheer', t: '쉬폰커튼', d: '자연 채광을 부드럽게 들이는 차르르한 느낌', s: '거실 · 다이닝룸', img: 'service-sheer-v3.webp' },
  { id: 'double', t: '이중커튼 (암막+쉬폰)', d: '낮과 밤의 채광을 자유롭게 조절합니다', s: '거실 · 침실', img: 'service-double-v3.webp' },
  { id: 'combi', t: '콤비블라인드', d: '빛 조절이 세밀하고 인테리어가 깔끔해집니다', s: '사무실 · 거실', img: 'service-combi-blind-v3.webp' },
  { id: 'wood', t: '우드블라인드', d: '원목 질감으로 고급스러운 분위기를 더합니다', s: '서재 · 카페', img: 'service-wood-blind-v2.webp' },
  { id: 'roll', t: '롤스크린', d: '공간을 차지하지 않아 좁은 공간에 알맞습니다', s: '베란다 · 욕실', img: 'service-roll-screen-v6.webp' },
];
const price = [
  ['창문 크기', '폭과 높이, 창의 개수'],
  ['원단 종류', '쉬폰·암막·이중·기능성 원단'],
  ['주름 방식', '2배 주름·3배 주름 등'],
  ['형상기억', '주름 형태 유지 가공 여부'],
  ['설치 포함', '방문 설치비 포함 견적'],
];
const cases = [
  { href: '/블로그/light-but-not-see-through-fabric', img: 'case-living-sheer-ochang-v5.webp', alt: '오창 30평 거실 쉬폰커튼', t: '거실 쉬폰커튼', area: '청주 오창', meta: '30평 / 자연 채광' },
  { href: '/블로그/blackout-sheer-double-curtain', img: 'case-bedroom-blackout-osong-v3.webp', alt: '오송 24평 안방 암막커튼', t: '안방 암막커튼', area: '청주 오송', meta: '24평 / 빛 차단' },
  { href: '/블로그/blackout-sheer-double-curtain', img: 'case-living-double-ochang-v3.png', alt: '오창 33평 거실 이중커튼', t: '거실 이중커튼 (암막+쉬폰)', area: '청주 오창', meta: '33평 / 호텔식' },
  { href: '/블로그/curtain-vs-blind', img: 'case-office-combi-v2.webp', alt: '사무실 콤비블라인드', t: '사무실 콤비블라인드', area: '최근 시공', meta: '사무실 / 채광 조절' },
];
const reviews = [
  { a: 'K', q: '대표님과 함께 고민하고 완성해 가는 과정이 즐거웠습니다.', who: '청주 오창 K씨', src: '30평 거실 쉬폰커튼 · 네이버 플레이스 리뷰' },
  { a: 'J', q: '가격이 합리적이고 직접 수선해 주셔서 빠르게 마무리되었어요.', who: '청주 오송 J씨', src: '안방 암막커튼 · 구글 리뷰' },
  { a: 'P', q: '지인 소개로 연락드렸는데, 처음에 기대 안 했는데 매우 만족스럽습니다.', who: '청주 ○○동 P씨', src: '거실 이중커튼 · 네이버 플레이스 리뷰' },
];
---
<BaseLayout
  title="본대로홈 — 청주 오창 맞춤 커튼·블라인드 전문점"
  description="커튼 전문 12년, 방문 실측부터 맞춤 제작·설치까지. 청주 오창·오송 지역 맞춤 커튼·블라인드 전문점."
  page="home"
>
  <Fragment slot="head">
    <link rel="preload" as="image" href={POSTER} />
  </Fragment>

  <SiteHeader />
  <main id="main">
    <section class="hero" aria-label="소개">
      <video class="hero-video" id="home-hero-video" autoplay muted loop playsinline preload="metadata" poster={POSTER} src={VIDEO} aria-label="본대로홈 맞춤 커튼과 블라인드 소개 영상"></video>
      <div class="hero-shade" aria-hidden="true"></div>
      <div class="hero-copy">
        <h1><span class="line"><span>우리 집의 분위기를</span></span><span class="line"><span>바꾸는 커튼</span></span></h1>
        <p>빛과 공간에 맞춰, 오래 보고 싶은 창가를 만듭니다.</p>
        <div class="actions">
          <a class="btn btn-white" href={`tel:${business.phone}`}>전화 상담</a>
          <a class="btn btn-ghost" href="/문의#directions">매장 위치 보기</a>
        </div>
      </div>
      <button class="hero-pause" type="button" aria-controls="home-hero-video" aria-label="영상 일시정지"><svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><rect x="3" y="2" width="3.5" height="12" rx="1" /><rect x="9.5" y="2" width="3.5" height="12" rx="1" /></svg></button>
    </section>

    <section class="about">
      <div class="vtext" aria-hidden="true">About us</div>
      <div class="container about-grid">
        <div>
          <p class="eyebrow">About us</p>
          <h2 class="h2">그런데 왜<br />본대로홈인가요?</h2>
          <div class="bignum"><span class="num" data-count={business.careerYears}>{business.careerYears}</span><span class="lbl">년<br />커튼 전문</span></div>
        </div>
        <div style="padding-top:44px">
          <p>원단·색감·길이까지 고객님과 함께 보며 결정합니다. 카탈로그에서 고르는 커튼이 아니라, 댁의 분위기에 맞는 커튼을 찾아 드립니다.</p>
          <p>양장기능사 자격, 미싱 직접 보유. 기장이 안 맞거나 수선이 필요할 때 공장 재발주 없이 현장에서 바로 처리합니다.</p>
          <ul class="checks"><li>함께 고민해서 결정합니다</li><li>미싱 직접 보유, 빠른 수선</li><li>방문 실측으로 시작하는 맞춤 제작</li></ul>
          <div class="img-zoom"><img src="/images/contact-store-interior-v3.webp" alt="본대로홈 매장 내부" loading="lazy" /></div>
        </div>
      </div>
    </section>

    <section class="hww">
      <div class="container row">
        <div><p class="eyebrow">How we work</p><h2 class="h2">어떻게 진행되나요?</h2></div>
        <p>맞춤 제작 특성상 발주 후에는 취소가 어렵습니다. 실측 시 색감·원단·길이까지 함께 충분히 결정합니다.</p>
      </div>
    </section>
    <section class="steps" aria-label="서비스 과정 6단계">
      {steps.map((s, i) => (
        <a class="step" href={`/서비스과정#step-${i + 1}`}><div class="step-bg"><img src={`/images/${s.img}`} alt="" loading="lazy" /></div><div class="step-body"><div class="step-num">{String(i + 1).padStart(2, '0')}</div><h3 set:html={s.h} /><p class="step-desc">{s.d}</p><span class="step-more">자세히 보기 →</span></div></a>
      ))}
    </section>

    <section class="services">
      <div class="container svc-grid">
        <div>
          <p class="eyebrow">Our products</p>
          <h2 class="h2">이런 제품을<br />만들어 드립니다</h2>
          <p>모든 제품은 댁의 창문에 맞춰 직접 제작합니다. 매장에서 원단을 직접 보시고 결정하세요.</p>
          <a class="btn btn-primary" href="/서비스">전체 서비스 자세히 보기 <Fragment set:html={ARROW} /></a>
        </div>
        <div class="svc-list">
          {services.map((s) => (
            <a class="svc" href={`/서비스#${s.id}`}><div class="thumb"><img src={`/images/${s.img}`} alt="" loading="lazy" /></div><div><h3>{s.t}</h3><p>{s.d}</p><small>{s.s}</small></div></a>
          ))}
        </div>
      </div>
    </section>

    <section class="why">
      <div class="container why-grid">
        <div class="img-zoom"><img src="/images/case-living-double-ochang-v3.png" alt="오창 거실 이중커튼 시공" loading="lazy" /></div>
        <div>
          <p class="eyebrow">Price guide</p>
          <h2 class="h2">거실 커튼,<br />얼마부터 시작할까요?</h2>
          <p class="why-lead">"거실 커튼 얼마예요?" — 가장 많이 받는 첫 질문입니다. 커튼 가격은 아래 다섯 가지에 따라 달라집니다.</p>
          <div class="acc">
            {price.map(([t, d], i) => (
              <div class:list={['acc-item', { open: i === 0 }]}><button type="button" aria-expanded={i === 0 ? 'true' : 'false'}><span class="acc-ic"></span>{t}</button><div class="acc-panel"><p>{d}</p></div></div>
            ))}
          </div>
          <div class="why-foot">
            <small>그래서 정확한 금액은 방문 실측 후에 확정해 드립니다. 다만 전화 한 통이면 대략적인 가격대를 바로 안내해 드릴 수 있습니다.</small>
            <a class="btn btn-dark" href={`tel:${business.phone}`}>지금 전화로 대략 안내받기 <Fragment set:html={ARROW} /></a>
          </div>
        </div>
      </div>
    </section>

    <section class="projects" id="cases">
      <div class="container proj-head">
        <div><p class="eyebrow">Our works</p><h2 class="h2">최근 시공 사례</h2></div>
        <a class="btn btn-dark" href="/블로그">블로그에서 더 많은 사례 보기 <Fragment set:html={ARROW} /></a>
      </div>
      <div class="track-wrap">
        <div class="track">
          {cases.map((c) => (
            <a class="proj" href={c.href}><div class="img-zoom"><img src={`/images/${c.img}`} alt={c.alt} draggable="false" loading="lazy" /></div><h3>{c.t}</h3><div class="cat"><b>{c.area}</b> / {c.meta}</div></a>
          ))}
        </div>
      </div>
      <div class="container proj-nav"><button class="round-btn" type="button" data-p="-1" aria-label="이전 사례"><svg width="18" height="18" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M15 8H2M7 3L2 8l5 5" /></svg></button><button class="round-btn" type="button" data-p="1" aria-label="다음 사례"><svg width="18" height="18" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M1 8h13M9 3l5 5-5 5" /></svg></button></div>
    </section>

    <section class="video" style={`background-image:url(${POSTER})`} aria-label="본대로홈 소개 영상">
      <button class="play" type="button" aria-label="소개 영상 재생"><svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg></button>
    </section>
    <div class="modal" role="dialog" aria-label="소개 영상"><button class="modal-close" type="button" aria-label="닫기">×</button><video controls playsinline preload="none" src={VIDEO}></video></div>

    <section class="quick">
      <div class="container">
        <a class="ql" href="/문의#visit"><span class="ic"><svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M12 21s-7-6.1-7-11.5A7 7 0 0 1 19 9.5C19 14.9 12 21 12 21z" /><circle cx="12" cy="9.5" r="2.5" /></svg></span><span>매장 방문</span></a>
        <a class="ql" href="/문의#visit"><span class="ic"><svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M4 4h7v16H4zM11 4l6 2-3 14-3-1" /><path d="M7.5 8v2" /></svg></span><span>원단 샘플 보기</span></a>
        <a class="ql" href="/서비스#price"><span class="ic"><svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><rect x="5" y="3" width="14" height="18" rx="1.5" /><path d="M8 7h8M8 11h2M12 11h2M16 11h0M8 15h2M12 15h2M8 18h2M12 18h2" /></svg></span><span>가격 안내</span></a>
        <a class="ql" href="/FAQ"><span class="ic"><svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M12 4C7 4 3 7.1 3 11c0 2.4 1.5 4.5 3.9 5.8L6 20l3.6-2.3c.8.2 1.6.3 2.4.3 5 0 9-3.1 9-7s-4-7-9-7z" /></svg></span><span>자주 묻는 질문</span></a>
      </div>
    </section>

    <section class="testi">
      <div class="container testi-grid">
        <div>
          <p class="eyebrow">Testimonials</p>
          <h2 class="h2">고객님들의<br />이야기</h2>
          <p>네이버 플레이스와 구글에 남겨 주신 후기입니다.</p>
          <a class="btn btn-dark" href="/문의#reviews">더 많은 후기 보기 <Fragment set:html={ARROW} /></a>
        </div>
        <div class="t-wrap">
          <div class="t-track">
            {reviews.map((r) => (
              <figure class="tcard"><div class="avatar">{r.a}</div><div class="stars" aria-label="별점 5점">★★★★★</div><blockquote>"{r.q}"</blockquote><b>{r.who}</b><small>{r.src}</small></figure>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="blog">
      <div class="container">
        <div class="head"><p class="eyebrow">Our blog</p><h2 class="h2">최근 글</h2></div>
        <div class="blog-grid">
          {posts.map((p) => (
            <a class="post" href={`/블로그/${p.id}`}>
              <div class="img-zoom"><Image src={p.data.heroImage} alt="" width={720} height={480} loading="lazy" /></div>
              <div class="meta">{dot(p.data.pubDate)} <i></i> {p.data.category}</div>
              <h3>{p.data.title}</h3>
              <p>{p.data.description}</p>
              <span class="more-link">READ MORE</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="visit">
      <div class="container">
        <p class="eyebrow">Visit our store</p>
        <h2 class="h2">매장에서 직접<br />원단을 확인하세요</h2>
        <p>카탈로그 사진과 실제 원단은 다릅니다. 본대로홈 매장에 오시면 원단을 직접 만져 보고, 햇빛 아래에서 색감을 확인하실 수 있습니다.</p>
        <div class="info"><span>{business.address.full}</span><span>{business.hours.display} · {business.hours.holiday}</span></div>
        <div class="actions">
          <a class="btn btn-primary" href={`tel:${business.phone}`}>전화 상담 <Fragment set:html={ARROW} /></a>
          <a class="btn btn-line" href={business.mapUrl} target="_blank" rel="noopener">네이버 지도에서 보기</a>
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>

<script>
  /* 메인 전용 동작 (시안 v3 그대로) */
  const hv = document.querySelector<HTMLVideoElement>('.hero-video');
  const hp = document.querySelector<HTMLButtonElement>('.hero-pause');
  const PAUSE = '<svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><rect x="3" y="2" width="3.5" height="12" rx="1"/><rect x="9.5" y="2" width="3.5" height="12" rx="1"/></svg>';
  const PLAY = '<svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M4 2l10 6-10 6z"/></svg>';
  if (hv && hp) {
    // 움직임 줄이기를 켠 사용자에게는 자동재생하지 않고 정지 화면(poster)만 보여준다.
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      hv.removeAttribute('autoplay'); hv.pause();
      hp.setAttribute('aria-label', '영상 재생'); hp.innerHTML = PLAY;
    }
    hp.addEventListener('click', () => {
      if (hv.paused) { hv.play(); hp.setAttribute('aria-label', '영상 일시정지'); hp.innerHTML = PAUSE; }
      else { hv.pause(); hp.setAttribute('aria-label', '영상 재생'); hp.innerHTML = PLAY; }
    });
  }

  /* 숫자 카운터: 화면에 보이면 0 → 목표값 */
  const io = new IntersectionObserver((es) => {
    es.forEach((e) => {
      if (!e.isIntersecting) return;
      const el = e.target as HTMLElement; const to = +(el.dataset.count || 0); let t0: number | null = null;
      const step = (t: number) => { if (!t0) t0 = t; const p = Math.min((t - t0) / 2000, 1); el.textContent = String(Math.round(to * (1 - Math.pow(1 - p, 3)))); if (p < 1) requestAnimationFrame(step); };
      requestAnimationFrame(step); io.unobserve(el);
    });
  }, { threshold: 0.4 });
  document.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => { el.textContent = '0'; io.observe(el); });

  /* 아코디언 */
  const items = Array.from(document.querySelectorAll<HTMLElement>('.acc-item'));
  const setH = (it: HTMLElement) => { const p = it.querySelector<HTMLElement>('.acc-panel')!; p.style.height = it.classList.contains('open') ? p.scrollHeight + 'px' : '0px'; };
  items.forEach((it) => {
    setH(it);
    it.querySelector('button')!.addEventListener('click', () => {
      const was = it.classList.contains('open');
      items.forEach((o) => { o.classList.remove('open'); o.querySelector('button')!.setAttribute('aria-expanded', 'false'); setH(o); });
      if (!was) { it.classList.add('open'); it.querySelector('button')!.setAttribute('aria-expanded', 'true'); setH(it); }
    });
  });

  /* 시공 사례 캐러셀: 드래그 + 화살표 + 자동 */
  const track = document.querySelector<HTMLElement>('.track');
  if (track) {
    const cards = Array.from(track.children) as HTMLElement[]; let pi = 0; let ptimer: number | undefined;
    const stepW = () => cards[0].offsetWidth + 30;
    const maxIndex = () => Math.max(0, Math.ceil((track.scrollWidth - (track.parentNode as HTMLElement).clientWidth) / stepW()));
    const prestart = () => { clearInterval(ptimer); ptimer = window.setInterval(() => pgo(pi + 1), 4500); };
    const pgo = (i: number) => { const m = maxIndex(); pi = i > m ? 0 : i < 0 ? m : i; track.style.transform = `translateX(${-pi * stepW()}px)`; prestart(); };
    document.querySelectorAll<HTMLButtonElement>('.proj-nav button').forEach((b) => b.addEventListener('click', () => pgo(pi + +(b.dataset.p || 0))));
    let sx: number | null = null; let moved = false;
    track.addEventListener('pointerdown', (e) => { sx = e.clientX; moved = false; });
    window.addEventListener('pointerup', (e) => { if (sx === null) return; const dx = e.clientX - sx; if (Math.abs(dx) > 50) { moved = true; pgo(pi + (dx < 0 ? 1 : -1)); } sx = null; });
    track.addEventListener('click', (e) => { if (moved) { e.preventDefault(); moved = false; } }, true);
    prestart();
  }

  /* 후기 캐러셀 */
  const tt = document.querySelector<HTMLElement>('.t-track');
  if (tt) {
    const tc = Array.from(tt.children) as HTMLElement[]; let ti = 0;
    setInterval(() => { const per = window.innerWidth <= 768 ? 1 : 2; const m = tc.length - per; ti = ti >= m ? 0 : ti + 1; tt.style.transform = `translateX(${-ti * (tc[0].offsetWidth + 30)}px)`; }, 5000);
  }

  /* 영상 팝업 */
  const modal = document.querySelector<HTMLElement>('.modal');
  if (modal) {
    const vid = modal.querySelector('video')!;
    document.querySelector('.play')!.addEventListener('click', () => { modal.classList.add('open'); vid.play().catch(() => {}); });
    const closeM = () => { modal.classList.remove('open'); vid.pause(); };
    modal.querySelector('.modal-close')!.addEventListener('click', closeM);
    modal.addEventListener('click', (e) => { if (e.target === modal) closeM(); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && modal.classList.contains('open')) closeM(); });
  }

  /* 맨 위로 */
  const top = document.querySelector<HTMLElement>('.to-top');
  if (top) {
    window.addEventListener('scroll', () => top.classList.toggle('show', scrollY > 600), { passive: true });
    top.addEventListener('click', () => scrollTo({ top: 0, behavior: 'smooth' }));
  }
</script>
