---
import { business } from '../../data/business';
import { css } from '../../lib/css';
import Icon from '../Icon.astro';
const { storePhone } = business;
const STORE_PHONE = storePhone;
const ADDRESS = business.address.full;
---
<section class="block" style={css({ background: "var(--surface-soft)" })}>
  <div class="container">
    <div class="visit-grid">
      <div style={css({ display: "flex", flexDirection: "column", justifyContent: "center" })}>
        <div class="section-eyebrow">매장 방문</div>
        <h2 class="section-title" style={css({ fontSize: "clamp(28px, 4vw, 40px)" })}>원단은 직접 보고<br />고르는 게 제일 정확해요</h2>
        <p style={css({ fontSize: 17, lineHeight: 1.8, color: "var(--slate)", margin: "8px 0 24px", maxWidth: 520, wordBreak: "keep-all" })}>
          온라인 사진과 실물은 다를 수 있어요. 매장에 오시면 원단의 두께·질감·색을 직접 만져보고, 암막·쉬폰·블라인드 샘플을 비교해 보실 수 있어요. 방문 전에 전화 주시면 더 편하게 안내해 드려요.
        </p>
        <div style={css({ display: "flex", flexDirection: "column", gap: 10, marginBottom: 24 })}>
          <div style={css({ display: "flex", gap: 12, fontSize: 15.5, color: "var(--charcoal)" })}>
            <Icon name="pin" size={18} /><span style={css({ wordBreak: "keep-all" })}>{ADDRESS}</span>
          </div>
          <div style={css({ display: "flex", gap: 12, fontSize: 15.5, color: "var(--charcoal)" })}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style={css({ flexShrink: 0, color: "var(--steel)" })}>
              <circle cx="12" cy="12" r="9" /><polyline points="12 7 12 12 15.5 14" />
            </svg><span>평일 오전 10:30 – 오후 7:00 (일·공휴일 휴무)</span>
          </div>
        </div>
        <div class="hero-ctas">
          <a class="btn btn-primary btn-lg" href={`tel:${STORE_PHONE}`}><Icon name="phone" /> 방문 전 전화하기</a>
        </div>
      </div>
      <div style={css({ borderRadius: "var(--rounded-xl)", overflow: "hidden", boxShadow: "var(--shadow-2)", alignSelf: "stretch" })}>
        <img src="/images/process-store-interior.webp" alt="본대로홈 매장 내부 — 원단과 커튼 샘플 전시" loading="lazy" style={css({ width: "100%", height: "100%", minHeight: 320, objectFit: "cover", display: "block" })} />
      </div>
    </div>
  </div>
</section>
