---
import { business } from '../../data/business';
import { css } from '../../lib/css';
import Icon from '../Icon.astro';
const { phone, storePhone, mapUrl } = business;
const PHONE = phone;
const STORE_PHONE = storePhone;
const MAP_URL = mapUrl;
---
<section id="directions" class="block">
  <div class="container">
    <div style={css({ marginBottom: 36, maxWidth: 680 })}>
      <div class="section-eyebrow">오시는 길</div>
      <h2 class="section-title">오시는 길</h2>
    </div>
    <div class="store-grid">
      <div class="store-info">
        <div>
          <div style={css({ fontSize: 13, fontWeight: 700, color: "var(--brand-orange-deep)", letterSpacing: "0.1em", textTransform: "uppercase", marginBottom: 8 })}>매장 안내</div>
          <h3 style={css({ fontFamily: "'Gowun Batang', serif", fontSize: 24, fontWeight: 700, margin: 0, color: "var(--ink-deep)" })}>{business.name}</h3>
        </div>
        <dl>
          <dt>주소</dt>
          <dd>{business.address.full}</dd>
          <dt>영업시간</dt>
          <dd>평일 오전 10:30 – 오후 7:00<br /><span style={css({ color: "var(--steel)" })}>일요일 · 공휴일 휴무</span></dd>
          <dt>매장 전화</dt>
          <dd><a href={`tel:${STORE_PHONE}`} style={css({ color: "var(--link-blue)", fontWeight: 600 })}>{STORE_PHONE}</a></dd>
          <dt>휴대폰</dt>
          <dd><a href={`tel:${PHONE}`} style={css({ color: "var(--link-blue)", fontWeight: 600 })}>{PHONE}</a></dd>
        </dl>
        <div style={css({ display: "flex", gap: 10, marginTop: "auto", paddingTop: 8, flexWrap: "wrap" })}>
          <a class="btn btn-primary" href={`tel:${PHONE}`}><Icon name="phone" /> 전화 상담</a>
          <a class="btn btn-secondary" href={MAP_URL} target="_blank" rel="noopener"><Icon name="pin" /> 매장 위치 자세히 보기</a>
        </div>
      </div>

      <a class="map-card" href={MAP_URL} target="_blank" rel="noopener" aria-label="네이버 지도에서 매장 위치 보기" style={css({ display: "block", position: "relative" })}>
        <img src="/images/bondaero-map.webp" alt={`${business.name} 매장 위치 지도 — ${business.address.full}`} style={css({ position: "absolute", inset: 0, width: "100%", height: "100%", objectFit: "cover", display: "block" })} />
        <span style={css({ position: "absolute", left: 16, bottom: 16, background: "#fff", color: "var(--ink)", fontSize: 13, fontWeight: 600, padding: "8px 12px", borderRadius: 999, boxShadow: "0 4px 14px rgba(0,0,0,0.12)", display: "inline-flex", alignItems: "center", gap: 6 })}>
          <Icon name="pin" size={14} /> 네이버 지도에서 보기
        </span>
      </a>
    </div>
  </div>
</section>
