---
import { css } from '../../lib/css';

const CREDENTIALS = [
  { k: "커튼 전문 12년", v: "봉제 경력 30년" },
  { k: "패션디자인산업기사", v: "양장기능사" },
  { k: "리본아트 사범 2급", v: "홈패션 강사 자격" },
  { k: "의류기술진흥경기대회", v: "동상 수상" },
];
---
<section class="block">
  <div class="container">
    <div style={css({ marginBottom: 36, maxWidth: 720 })}>
      <div class="section-eyebrow">소개</div>
      <h2 class="section-title" style={css({ fontSize: "clamp(28px, 4vw, 40px)" })}>본대로홈은 이런 곳이에요</h2>
      <p class="section-lede" style={css({ marginTop: 12 })}>
        청주 오창에서 커튼·블라인드를 맞춤 제작·설치하는 동네 전문점이에요. 카탈로그만 보고 추천하는 게 아니라, 원단 소재와 봉제 구조를 직접 다뤄온 경험으로 고객님 집에 맞는 커튼을 함께 정해드려요.
      </p>
    </div>
    <div class="cred-grid">
      {CREDENTIALS.map((c) => (
        <div style={css({ background: "var(--canvas)", border: "1px solid var(--hairline)", borderRadius: "var(--rounded-lg)", padding: "24px 24px 26px" })}>
          <div style={css({ width: 38, height: 38, borderRadius: "var(--rounded-md)", background: "var(--tint-mint)", display: "grid", placeItems: "center", marginBottom: 16, color: "var(--primary-deep)" })}>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="9" r="6" /><path d="M9 14.5 8 22l4-2 4 2-1-7.5" />
            </svg>
          </div>
          <div style={css({ fontSize: 17, fontWeight: 700, color: "var(--ink-deep)", marginBottom: 4, wordBreak: "keep-all" })}>{c.k}</div>
          <div style={css({ fontSize: 14.5, color: "var(--slate)", wordBreak: "keep-all" })}>{c.v}</div>
        </div>
      ))}
    </div>
  </div>
</section>
