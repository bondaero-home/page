---
import { business } from '../../data/business';
import { css } from '../../lib/css';
import Icon from '../Icon.astro';

const factors = ["창문 크기", "원단 종류", "주름 방식", "형상기억 여부", "설치비 포함 여부"];
---
<section class="block" style={css({ background: "var(--surface-soft)" })}>
  <div class="container" style={css({ maxWidth: 900 })}>
    <div style={css({ marginBottom: 28, textAlign: "center" })}>
      <div class="section-eyebrow">가격 안내</div>
      <h2 class="section-title">가격은 얼마부터 시작할까요?</h2>
      <p class="section-lede" style={css({ marginTop: 12, marginLeft: "auto", marginRight: "auto" })}>
        정확한 금액은 창마다 크기·원단이 달라서 미리 정해두기 어려워요.
        대신 전화 한 통이면 제품별 대략적인 시작 가격대를 바로 안내해 드립니다.
      </p>
    </div>

    <div class="card" style={css({ padding: 36 })}>
      <div style={css({ fontSize: 13, fontWeight: 700, letterSpacing: "0.08em", color: "var(--brand-orange-deep)", textTransform: "uppercase", marginBottom: 14 })}>가격을 결정하는 요소</div>
      <div class="pfactors">
        {factors.map((f) => <span class="chip">{f}</span>)}
      </div>
      <div style={css({ marginTop: 24, padding: "16px 18px", background: "var(--surface-soft)", borderRadius: 10, fontSize: 15, lineHeight: 1.7, color: "var(--slate)", wordBreak: "keep-all" })}>
        정확한 금액은 <b style={css({ color: "var(--ink)" })}>방문 실측 후 확정</b>해 드립니다.
        청주·오창·오송 지역 <b style={css({ color: "var(--ink)" })}>방문 실측 무료</b>, 그 외 지역은 전화로 문의해 주세요.
      </div>
      <div style={css({ marginTop: 24, textAlign: "center" })}>
        <a class="btn btn-primary btn-lg" href={`tel:${business.phone}`}><Icon name="phone" /> 지금 전화로 대략 안내받기</a>
      </div>
    </div>
  </div>
</section>
