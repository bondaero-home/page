---
import { business } from '../../data/business';
---
<footer class="footer">
  <div class="container ft-grid">
    <div class="ft-brand">
      <a class="logo" href="/"><img src="/images/mark.png" alt="" width="34" height="34" /><span>{business.name}</span></a>
      <p>청주 오창 맞춤 커튼·블라인드 전문점.<br />커튼 전문 {business.careerYears}년, 함께 고민하고 직접 만들어 드립니다.</p>
      <a class="ft-call" href={`tel:${business.phone}`}>
        <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="#6B8C5F" stroke-width="1.4" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z" /></svg>
        <span><b>{business.phone}</b><small>매장 {business.storePhone}</small></span>
      </a>
    </div>
    <div><h4>페이지</h4><ul><li><a href="/">메인</a></li><li><a href="/서비스">서비스</a></li><li><a href="/서비스과정">서비스 과정</a></li><li><a href="/FAQ">FAQ</a></li></ul></div>
    <div><h4>제품</h4><ul><li><a href="/서비스#blackout">암막커튼</a></li><li><a href="/서비스#sheer">쉬폰커튼</a></li><li><a href="/서비스#double">이중커튼</a></li><li><a href="/서비스#blinds">블라인드</a></li></ul></div>
    <div><h4>바로가기</h4><ul><li><a href="/블로그">블로그</a></li><li><a href="/블로그#cases">시공사례</a></li><li><a href="/문의">문의</a></li><li><a href={business.mapUrl} target="_blank" rel="noopener">네이버 지도</a></li></ul></div>
    <div><h4>매장 안내</h4><ul><li>{business.address.full}</li><li>{business.hours.weekdayDisplay}<br />{business.hours.saturdayDisplay}</li><li>{business.hours.holiday}</li></ul></div>
  </div>
  <div class="container ft-bottom">© {new Date().getFullYear()} {business.name} · 대표 {business.owner} · 사업자등록 {business.bizRegistration}</div>
</footer>

<button class="to-top" type="button" aria-label="맨 위로"><svg width="18" height="18" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M8 15V2M3 7l5-5 5 5" /></svg></button>

<nav class="mbar" aria-label="빠른 연락">
  <a href={`tel:${business.phone}`}><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z" /></svg>전화 상담</a>
  <a href="/문의"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 4C7 4 3 7.1 3 11c0 2.4 1.5 4.5 3.9 5.8L6 20l3.6-2.3c.8.2 1.6.3 2.4.3 5 0 9-3.1 9-7s-4-7-9-7z" /></svg>상담 문의</a>
  <a href="/문의#directions"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 21s-7-6.1-7-11.5A7 7 0 0 1 19 9.5C19 14.9 12 21 12 21z" /><circle cx="12" cy="9.5" r="2.5" /></svg>매장 길찾기</a>
</nav>

<script>
  import '../../scripts/site';
</script>
