---
import { css } from '../../lib/css';
import MidIcon from './MidIcon.astro';

const cards = [
  { tint: "tint-peach", title: "함께 고민해서 결정합니다", body: "원단·색감·길이까지 고객님과 함께 보며 결정합니다. 카탈로그에서 고르는 커튼이 아니라, 댁의 분위기에 맞는 커튼을 찾아 드립니다.", icon: "window" },
  { tint: "tint-yellow-bold", title: "방문 실측으로 시작하는 맞춤 제작", body: "정확한 견적은 현장에서 시작됩니다. 창문 방향·인테리어 색감까지 직접 보며 조율합니다. 청주·오창·오송은 방문 실측 무료, 그 외 지역은 전화로 문의해 주세요.", icon: "ruler", bold: true },
  { tint: "tint-mint", title: "미싱 직접 보유, 빠른 수선", body: "양장기능사 자격, 미싱 직접 보유. 기장이 안 맞거나 수선이 필요할 때 공장 재발주 없이 현장에서 바로 처리합니다.", icon: "needle" },
];
---
<section class="block" style={css({ background: "var(--surface-soft)" })}>
  <div class="container">
    <div style={css({ textAlign: "center", marginBottom: 48 })}>
      <div class="section-eyebrow">우리가 일하는 방식</div>
      <h2 class="section-title" style={css({ maxWidth: 720, margin: "0 auto" })}>
        그런데 왜 본대로홈인가요?
      </h2>
    </div>
    <div class="grid grid-3">
      {cards.map((c) => (
        <div class={`card-tint ${c.tint}`} style={css({ padding: 36, minHeight: 260 })}>
          <div style={css({ width: 48, height: 48, borderRadius: 10, background: c.bold ? "rgba(255,255,255,0.18)" : "rgba(255,255,255,0.55)", color: c.bold ? "#FFFFFF" : "var(--primary)", display: "grid", placeItems: "center", marginBottom: 22 })}><MidIcon name={c.icon} size={26} /></div>
          <h3 style={css({ margin: "0 0 12px", fontSize: 22, fontWeight: 700, lineHeight: 1.3, letterSpacing: "-0.3px" })}>{c.title}</h3>
          <p style={css({ margin: 0, fontSize: 15.5, lineHeight: 1.65, color: "var(--charcoal)", wordBreak: "keep-all" })}>{c.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>
