---
import { css } from '../../lib/css';

interface Props {
  kind: string;
}
const { kind } = Astro.props;

const photoMap: Record<string, { src: string; alt: string }> = {
  blackout: { src: "/images/service-blackout.webp", alt: "암막커튼 시공 사례" },
  sheer:    { src: "/images/service-sheer-v2.webp", alt: "쉬폰커튼 시공 사례 — 거실 통창에 건 쉬폰커튼 사이로 들어오는 자연광" },
  double:   { src: "/images/service-double-v2.webp", alt: "이중커튼 시공 사례 — 패턴 암막커튼과 쉬폰커튼을 겹친 거실 창" },
  combi:    { src: "/images/service-combi-blind.webp", alt: "콤비블라인드 시공 사례" },
  wood:     { src: "/images/service-wood-blind.webp",  alt: "우드블라인드 시공 사례" },
  roll:     { src: "/images/service-roll-screen.webp", alt: "롤스크린 시공 사례" },
};
const photo = photoMap[kind];
---
{photo && (
  <img src={photo.src} alt={photo.alt} loading="lazy" style={css({ width: "100%", height: "100%", objectFit: "cover", display: "block" })} />
)}
