---
import { css } from '../../lib/css';

interface Props {
  kind: string;
}
const { kind } = Astro.props;

const photoMap: Record<string, { src: string; alt: string }> = {
  blackout: { src: "/images/service-blackout-v2.webp", alt: "암막커튼 시공 사례 — 침실 창을 덮은 그레이 암막커튼" },
  sheer:    { src: "/images/service-sheer-v3.webp", alt: "쉬폰커튼 시공 사례 — 거실 통창에 건 쉬폰커튼 사이로 들어오는 자연광" },
  double:   { src: "/images/service-double-v3.webp", alt: "이중커튼 시공 사례 — 거실 통창에 겉커튼과 속커튼을 겹쳐 건 모습" },
  combi:    { src: "/images/service-combi-blind-v3.webp", alt: "베이지 콤비블라인드의 원단 띠 사이로 자연광이 들어오는 창" },
  wood:     { src: "/images/service-wood-blind-v2.webp",  alt: "식탁 뒤 통창에 설치한 밝은 원목 색상의 우드블라인드" },
  roll:     { src: "/images/service-roll-screen-v6.webp", alt: "아이보리와 회색 직조 질감의 롤스크린 제품 연출 이미지" },
};
const photo = photoMap[kind];
---
{photo && (
  <img src={photo.src} alt={photo.alt} loading="lazy" style={css({ width: "100%", height: "100%", objectFit: "cover", display: "block" })} />
)}
