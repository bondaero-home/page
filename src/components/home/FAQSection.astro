---
import { css } from '../../lib/css';
import Icon from '../Icon.astro';

const faqs = [
  { q: "거실 커튼 가격은 얼마부터인가요?", a: "창 크기, 원단, 주름 방식, 형상기억 여부에 따라 달라집니다. 전화 주시면 대략적 가격대를 안내해 드리고, 정확한 금액은 방문 실측 후에 확정합니다." },
  { q: "방문 실측은 무료인가요?", a: "네, 방문 실측은 무료입니다. 청주·오창·오송 지역은 추가 비용 없이 방문해 드립니다." },
  { q: "제작 기간은 얼마나 걸리나요?", a: "발주 후 약 1주일 내 제작이 완료됩니다. 설치 일정은 협의 후 결정합니다." },
  { q: "발주 후 취소가 가능한가요?", a: "맞춤 제작 특성상 발주 후에는 취소가 어렵습니다. 실측 시 색감, 원단, 길이까지 함께 충분히 결정합니다." },
];
---
<section class="block" id="faq">
  <div class="container" style={css({ maxWidth: 880 })}>
    <div style={css({ marginBottom: 40, textAlign: "center" })}>
      <div class="section-eyebrow">자주 묻는 질문</div>
      <h2 class="section-title">자주 묻는 질문</h2>
    </div>
    <div>
      {faqs.map((f, i) => (
        <details class="faq" {...(i === 0 ? { open: true } : {})}>
          <summary>
            <h5>{f.q}</h5>
            <span class="chev"><Icon name="chev-down" size={18} /></span>
          </summary>
          <div class="ans">{f.a}</div>
        </details>
      ))}
    </div>
    <div style={css({ marginTop: 32, textAlign: "center" })}>
      <a class="btn-link t-body-m" href="/FAQ" style={css({ display: "inline-flex", alignItems: "center", gap: 6 })}>
        전체 FAQ 보기 <Icon name="arrow-right" size={14} />
      </a>
    </div>
  </div>
</section>
