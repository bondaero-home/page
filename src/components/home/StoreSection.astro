---
import { business } from '../../data/business';
import { css } from '../../lib/css';
import Icon from '../Icon.astro';
---
<section class="block" id="store" style={css({ background: "var(--surface-soft)" })}>
  <div class="container">
    <div style={css({ marginBottom: 48, maxWidth: 720 })}>
      <div class="section-eyebrow" style={css({ color: "var(--brand-orange-deep)" })}>매장 안내</div>
      <h2 class="section-title">매장에서 직접 원단을 확인하세요</h2>
      <p class="section-lede" style={css({ marginTop: 16 })}>
        카탈로그 사진과 실제 원단은 다릅니다. 본대로홈 매장에 오시면 원단을 직접 만져 보고,
        햇빛 아래에서 색감을 확인하실 수 있습니다.
      </p>
    </div>

    <div class="store-grid">
      <div class="store-info">
        <div>
          <div style={css({ fontSize: 13, fontWeight: 700, color: "var(--brand-orange-deep)", letterSpacing: "0.1em", textTransform: "uppercase", marginBottom: 8 })}>매장 안내</div>
          <div style={css({ fontSize: 26, fontWeight: 700, letterSpacing: "0.01em", fontFamily: "'Gowun Batang', serif", WebkitTextStrokeWidth: "0.4px", WebkitTextStrokeColor: "currentColor" })}>{business.name}</div>
        </div>
        <dl>
          <dt>주소</dt>
          <dd>{business.address.full}</dd>
          <dt>영업시간</dt>
          <dd>{business.hours.display}</dd>
          <dt>매장 전화</dt>
          <dd><a href={`tel:${business.storePhone}`} style={css({ color: "var(--link-blue)", fontWeight: 600 })}>{business.storePhone}</a></dd>
          <dt>휴대폰</dt>
          <dd><a href={`tel:${business.phone}`} style={css({ color: "var(--link-blue)", fontWeight: 600 })}>{business.phone}</a></dd>
          <dt>휴무</dt>
          <dd style={css({ color: "var(--steel)" })}>일요일 · 공휴일</dd>
        </dl>
        <div style={css({ display: "flex", gap: 10, marginTop: "auto", paddingTop: 8, flexWrap: "wrap" })}>
          <a class="btn btn-primary" href={`tel:${business.phone}`}><Icon name="phone" /> 전화 상담</a>
          <a class="btn btn-secondary" href={business.mapUrl} target="_blank" rel="noopener"><Icon name="pin" /> 매장 위치 자세히 보기</a>
        </div>
      </div>

      <a class="map-card" href={business.mapUrl} target="_blank" rel="noopener" aria-label="네이버 지도에서 매장 위치 보기" style={css({ display: "block", textDecoration: "none" })}>
        <img src="/images/store-map.webp" alt={`${business.name} 매장 위치 지도`} style={css({ position: "absolute", inset: 0, width: "100%", height: "100%", objectFit: "cover", display: "block" })} />
        <span style={css({ position: "absolute", left: 16, bottom: 16, background: "#fff", color: "var(--ink)", fontSize: 13, fontWeight: 600, padding: "8px 12px", borderRadius: 999, boxShadow: "0 4px 12px rgba(0,0,0,0.12)", display: "inline-flex", alignItems: "center", gap: 6 })}>
          <Icon name="pin" size={14} /> 네이버 지도에서 보기
        </span>
      </a>
    </div>
  </div>
</section>
