---
import { css } from '../../lib/css';

interface Props {
  kind: string;
}
const { kind } = Astro.props;

const photoMap: Record<string, { src: string; alt: string }> = {
  livingSheer:     { src: "/images/case-living-sheer-ochang-v3.webp",        alt: "청주 오창 거실 쉬폰커튼 시공" },
  bedroomBlackout: { src: "/images/case-bedroom-blackout-osong-v2.webp",     alt: "청주 오송 안방 암막커튼 시공" },
  livingDouble:    { src: "/images/case-living-double-ochang.webp",       alt: "청주 오창 거실 이중커튼 시공" },
  officeCombi:     { src: "/images/case-office-combi-ochang-science.webp", alt: "청주 오창과학단지 사무실 콤비블라인드 시공" },
};
const photo = photoMap[kind];
const placeholders: Record<string, string> = {
  livingSheer: "data:image/webp;base64,UklGRnwAAABXRUJQVlA4IHAAAAAwBACdASoYAA0APwForE6rJaQiMAgBYCAJQBOgBDwSLHItucj8bJMz0QAA/rfDLfA35V6jUQxMgi/TmhpMVqZgQ+yc1gll/iKmFTMkcw/vQu7EyEezZnog5AZti5FESL4hTlmKkJU9FwSYCJAV3wAA",
  bedroomBlackout: "data:image/webp;base64,UklGRkgAAABXRUJQVlA4IDwAAABwAwCdASoYAA0APwFIu1grIqckmAFgIAlpAABc6f8YhcXQ30AA/e6vgWJLozCv2pRJ/tk3WX2+KU2gAAA=",
};
const placeholder = placeholders[kind];
---
{photo && (
  <img src={photo.src} alt={photo.alt} width="800" height="440" loading="lazy" decoding="async" style={css({ width: "100%", height: "100%", objectFit: "cover", objectPosition: "center", display: "block", backgroundImage: placeholder ? `url("${placeholder}")` : undefined, backgroundSize: "cover", backgroundPosition: "center" })} />
)}
