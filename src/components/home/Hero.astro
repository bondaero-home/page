---
import { business } from '../../data/business';
import Icon from '../Icon.astro';
---
<section class="hero hero--intro">
  <div class="hero-film">
  <video
    class="hero-video"
    id="home-hero-video"
    src="/videos/hero-v15-natural-entrance.mp4"
    poster="/images/hero-poster-v15-natural-entrance.jpg"
    width="1920"
    height="1080"
    autoplay
    muted
    loop
    playsinline
    preload="metadata"
    aria-label="본대로홈 맞춤 커튼과 블라인드 소개 영상"
  ></video>
    <div class="hero-film-brand">
      <p class="hero-film-message">당신의 공간을, 정성껏.</p>
      <span class="hero-film-name">본대로홈</span>
    </div>
  </div>
  <div class="container hero-inner">
    <button class="hero-video-toggle" type="button" aria-controls="home-hero-video" hidden>영상 일시정지</button>
    <div class="hero-copy">
      <h1>우리 집의 분위기를<br />바꾸는 커튼</h1>
      <p class="sub">빛과 공간에 맞춰, 오래 보고 싶은 창가를 만듭니다.</p>
    </div>
    <div class="hero-ctas">
      <a class="btn btn-primary btn-lg" href={`tel:${business.phone}`}>
        <Icon name="phone" /> 전화 상담
      </a>
      <a class="btn btn-secondary btn-lg" href={business.mapUrl} target="_blank" rel="noopener">
        <Icon name="pin" /> 매장 위치 보기
      </a>
    </div>
  </div>
</section>

<style>
  .hero.hero--intro {
    display: block;
    min-height: 0;
    padding: 0;
  }
  .hero--intro .hero-video {
    display: block;
    position: relative;
    inset: auto;
    z-index: 0;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: contain;
    filter: none;
  }
  .hero-film { position: relative; }
  .hero-film::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 24%;
    background: linear-gradient(transparent, rgba(25, 23, 20, .22));
    pointer-events: none;
  }
  .hero-film-brand {
    position: absolute;
    z-index: 1;
    left: clamp(20px, 4vw, 64px);
    bottom: clamp(16px, 3vw, 40px);
    color: #fff;
    font-family: 'Gowun Batang', serif;
    font-weight: 400;
    line-height: 1.3;
    text-shadow: 0 1px 6px rgba(0, 0, 0, .2);
    pointer-events: none;
  }
  .hero--intro .hero-film-message {
    margin: 0 0 8px;
    color: rgba(255, 255, 255, .94);
    font-size: clamp(19px, 2.4vw, 36px);
    line-height: 1.5;
  }
  .hero-film-name {
    display: block;
    color: rgba(255, 255, 255, .82);
    font-size: clamp(14px, 1.3vw, 19px);
    line-height: 1.5;
  }
  .hero--intro .hero-inner {
    height: auto;
    padding: 20px 24px;
    transform: none;
    background: var(--canvas);
  }
  .hero--intro .hero-copy {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .hero--intro .hero-ctas {
    position: static;
    transform: none;
    width: auto;
    margin-top: 0;
  }
  .hero--intro .btn-secondary-on-dark,
  .hero--intro .btn-secondary {
    color: var(--ink);
    background: var(--canvas);
    border-color: var(--hairline-strong);
    text-shadow: none;
  }
  .hero--intro .hero-video-toggle {
    position: static;
    align-self: flex-end;
    margin: 0 0 12px;
    min-height: 36px;
    padding: 6px 12px;
    font-size: 12px;
    line-height: 1.4;
  }
  @media (max-width: 560px) {
    .hero--intro .hero-inner { padding: 16px 20px; }
    .hero--intro .hero-ctas { width: 100%; }
  }
</style>

<script>
  const video = document.querySelector<HTMLVideoElement>('.hero-video');
  const toggle = document.querySelector<HTMLButtonElement>('.hero-video-toggle');
  const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const mobile = window.matchMedia('(max-width: 640px)');
  const floatingCall = document.querySelector<HTMLElement>('.mfloat');
  if (video && toggle) {
    const syncLabel = () => {
      toggle.textContent = video.paused ? '영상 재생' : '영상 일시정지';
    };
    const respectMotion = () => {
      if (motion.matches) { video.removeAttribute('autoplay'); video.pause(); video.currentTime = 0; }
      syncLabel();
    };
    respectMotion();
    motion.addEventListener('change', respectMotion);
    mobile.addEventListener('change', respectMotion);
    if (floatingCall && 'IntersectionObserver' in window) {
      const hero = document.querySelector<HTMLElement>('.hero');
      if (hero) new IntersectionObserver(([entry]) => {
        floatingCall.style.visibility = entry.isIntersecting && mobile.matches ? 'hidden' : 'visible';
      }, { threshold: 0.08 }).observe(hero);
    }
    video.addEventListener('play', syncLabel);
    video.addEventListener('pause', syncLabel);
    toggle.hidden = false;
    toggle.addEventListener('click', async () => {
      if (video.paused) {
        try { await video.play(); } catch { syncLabel(); }
      } else {
        video.pause();
      }
    });
  }
</script>

<style>
  .hero-video-toggle {
    position: absolute;
    right: 16px;
    bottom: 16px;
    min-height: 44px;
    padding: 10px 16px;
    border: 1px solid var(--hairline);
    border-radius: 999px;
    background: var(--surface-soft);
    color: var(--ink-deep);
    font: inherit;
    font-size: 13px;
    cursor: pointer;
  }
  .hero-video-toggle:focus-visible {
    outline: 3px solid var(--primary-deep);
    outline-offset: 3px;
  }
</style>
