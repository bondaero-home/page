---
import { business } from '../../data/business';
import Icon from '../Icon.astro';
---
<section class="hero">
  <video
    class="hero-video"
    id="home-hero-video"
    src="/videos/hero.mp4"
    poster="/images/hero-poster-v8-original.jpg"
    width="1920"
    height="1080"
    autoplay
    muted
    loop
    playsinline
    preload="metadata"
    aria-label="본대로홈 맞춤 커튼과 블라인드 소개 영상"
  ></video>
  <div class="hero-shade" aria-hidden="true"></div>
  <div class="container hero-inner">
    <p class="hero-eyebrow">본대로홈 · 맞춤 커튼과 블라인드</p>
    <h1>우리 집의 분위기를<br />바꾸는 커튼</h1>
    <p class="sub">빛과 공간에 맞춰, 오래 보고 싶은 창가를 만듭니다.</p>
    <div class="hero-ctas">
      <a class="btn btn-primary btn-lg" href={`tel:${business.phone}`}>
        <Icon name="phone" /> 지금 전화 상담하기
      </a>
      <a class="btn btn-secondary btn-lg" href={business.mapUrl} target="_blank" rel="noopener">
        <Icon name="pin" /> 매장 위치 보기
      </a>
    </div>
  </div>
  <button class="hero-video-toggle" type="button" aria-controls="home-hero-video" hidden>영상 일시정지</button>
</section>

<script>
  const video = document.querySelector<HTMLVideoElement>('.hero-video');
  const toggle = document.querySelector<HTMLButtonElement>('.hero-video-toggle');
  const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
  if (video && toggle) {
    const syncLabel = () => {
      toggle.textContent = video.paused ? '영상 재생' : '영상 일시정지';
    };
    const respectMotion = () => {
      if (motion.matches) { video.removeAttribute('autoplay'); video.pause(); video.currentTime = 0; }
      syncLabel();
    };
    respectMotion();
    motion.addEventListener('change', respectMotion);
    video.addEventListener('play', syncLabel);
    video.addEventListener('pause', syncLabel);
    toggle.hidden = false;
    toggle.addEventListener('click', async () => {
      if (video.paused) {
        try { await video.play(); } catch { syncLabel(); }
      } else {
        video.pause();
      }
    });
  }
</script>

<style>
  .hero-video-toggle {
    position: absolute;
    right: 16px;
    bottom: 16px;
    min-height: 44px;
    padding: 10px 16px;
    border: 1px solid var(--hairline);
    border-radius: 999px;
    background: var(--surface-soft);
    color: var(--ink-deep);
    font: inherit;
    font-size: 13px;
    cursor: pointer;
  }
  .hero-video-toggle:focus-visible {
    outline: 3px solid var(--primary-deep);
    outline-offset: 3px;
  }
</style>
