---
import { business } from '../../data/business';
import Icon from '../Icon.astro';
---
<section class="hero">
  <div class="container hero-inner">
    <div class="trust" aria-label="신뢰 배지">
      <span class="badge">● 경력 12년</span>
      <span class="badge">● 공장 직영 협업</span>
      <span class="badge">● 미싱 직접 보유</span>
    </div>
    <h1>
      청주 오창<br />
      맞춤 커튼·블라인드<br />
      전문점
    </h1>
    <p class="sub">
      커튼 전문 12년, 함께 고민하고 직접 만들어 드립니다.<br />
      매장에서 원단을 직접 보시고, 댁에 맞는 커튼을 결정하세요.
    </p>
    <div class="hero-ctas">
      <a class="btn btn-primary btn-lg" href={`tel:${business.phone}`}>
        <Icon name="phone" /> 지금 전화 상담하기
      </a>
      <a class="btn btn-secondary btn-lg" href={business.mapUrl} target="_blank" rel="noopener">
        <Icon name="pin" /> 매장 위치 보기
      </a>
    </div>
  </div>
  <div class="container">
    <div class="hero-photo">
      <video
        class="hero-video"
        src="/videos/hero-v6.mp4"
        poster="/images/hero-poster-v6.webp"
        autoplay
        muted
        loop
        playsinline
        preload="auto"
        aria-label="청주 오창 거실 쉬어커튼 시공 영상"
      ></video>
    </div>
  </div>
</section>

<script>
  // 움직임 최소화를 켠 사용자에게는 재생하지 않고 포스터 이미지만 보여준다.
  // (CSS로는 video 재생을 막을 수 없어 스크립트가 필요하다)
  const video = document.querySelector<HTMLVideoElement>('.hero-video');
  if (video && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    video.removeAttribute('autoplay');
    video.pause();
  }
</script>
