---
import { business } from '../../data/business';
import Icon from '../Icon.astro';
---
<section class="hero">
  <div class="container hero-inner">
    <div class="trust" aria-label="신뢰 배지">
      <span class="badge">● 경력 12년</span>
      <span class="badge">● 공장 직영 협업</span>
      <span class="badge">● 미싱 직접 보유</span>
    </div>
    <h1>
      청주 오창<br />
      맞춤 커튼·블라인드<br />
      전문점
    </h1>
    <p class="sub">
      커튼 전문 12년, 함께 고민하고 직접 만들어 드립니다.<br />
      매장에서 원단을 직접 보시고, 댁에 맞는 커튼을 결정하세요.
    </p>
    <div class="hero-ctas">
      <a class="btn btn-primary btn-lg" href={`tel:${business.phone}`}>
        <Icon name="phone" /> 지금 전화 상담하기
      </a>
      <a class="btn btn-secondary btn-lg" href={business.mapUrl} target="_blank" rel="noopener">
        <Icon name="pin" /> 매장 위치 보기
      </a>
    </div>
  </div>
  <div class="container">
    <div class="hero-photo">
      <video
        class="hero-video"
        id="home-hero-video"
        src="/videos/hero-v8-original.mp4"
        poster="/images/hero-poster-v8-original.jpg"
        width="1280"
        height="720"
        autoplay
        muted
        loop
        playsinline
        preload="auto"
        aria-label="본대로홈 매장의 레이스 커튼과 꽃무늬 원단 소개 영상"
      ></video>
      <button class="hero-video-toggle" type="button" aria-controls="home-hero-video" hidden>영상 일시정지</button>
    </div>
  </div>
</section>

<script>
  const video = document.querySelector<HTMLVideoElement>('.hero-video');
  const toggle = document.querySelector<HTMLButtonElement>('.hero-video-toggle');
  const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
  if (video && toggle) {
    const syncLabel = () => {
      toggle.textContent = video.paused ? '영상 재생' : '영상 일시정지';
    };
    const respectMotion = () => {
      if (motion.matches) {
        video.removeAttribute('autoplay');
        video.pause();
        video.currentTime = 0;
      }
      syncLabel();
    };
    respectMotion();
    motion.addEventListener('change', respectMotion);
    video.addEventListener('play', syncLabel);
    video.addEventListener('pause', syncLabel);
    toggle.hidden = false;
    toggle.addEventListener('click', async () => {
      if (video.paused) {
        try { await video.play(); } catch { syncLabel(); }
      } else {
        video.pause();
      }
    });
  }
</script>

<style>
  .hero-video-toggle {
    position: absolute;
    right: 16px;
    bottom: 16px;
    min-height: 44px;
    padding: 10px 16px;
    border: 1px solid var(--hairline);
    border-radius: 999px;
    background: var(--surface-soft);
    color: var(--ink-deep);
    font: inherit;
    font-size: 13px;
    cursor: pointer;
  }
  .hero-video-toggle:focus-visible {
    outline: 3px solid var(--primary-deep);
    outline-offset: 3px;
  }
</style>
