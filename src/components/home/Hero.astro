---
import { business } from '../../data/business';
import Icon from '../Icon.astro';
---
<section class="hero hero--intro">
  <div class="hero-film">
  <video
    class="hero-video"
    id="home-hero-video"
    src="/videos/hero-v19-clean-background.mp4"
    poster="/images/hero-poster-v17-reviewed-story.jpg"
    width="1920"
    height="1080"
    autoplay
    muted
    loop
    playsinline
    preload="metadata"
    aria-label="본대로홈 맞춤 커튼과 블라인드 소개 영상"
  ></video>
    <div class="hero-brand-story">
      <p>한 땀의 정성에 당신의 취향을 담아,<br />공간에 맞추고 마지막까지 꼼꼼히 살핍니다.</p>
      <span>본대로홈</span>
    </div>
  <div class="hero-inner">
    <button class="hero-video-toggle" type="button" aria-controls="home-hero-video" hidden aria-label="영상 일시정지" title="영상 일시정지">Ⅱ</button>
    <div class="hero-copy">
      <h1>우리 집의 분위기를<br />바꾸는 커튼</h1>
      <p class="sub">빛과 공간에 맞춰, 오래 보고 싶은 창가를 만듭니다.</p>
    </div>
    <div class="hero-ctas">
      <a class="btn btn-primary btn-lg" href={`tel:${business.phone}`}>
        <Icon name="phone" /> 전화 상담
      </a>
      <a class="btn btn-secondary btn-lg" href={business.mapUrl} target="_blank" rel="noopener">
        <Icon name="pin" /> 매장 위치 보기
      </a>
    </div>
  </div>
  </div>
</section>

<style>
  .hero.hero--intro {
    display: block;
    min-height: 0;
    padding: 0;
  }
  .hero--intro .hero-video {
    display: block;
    position: relative;
    inset: auto;
    z-index: 0;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: contain;
    filter: none;
  }
  .hero-film { position: relative; }
  .hero-film::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 24%;
    background: linear-gradient(transparent, rgba(25, 23, 20, .22));
    pointer-events: none;
  }
  .hero--intro .hero-inner {
    position: absolute;
    inset: 0;
    z-index: 2;
    width: 100%;
    height: 100%;
    padding: 0;
    transform: none;
    background: transparent;
    pointer-events: none;
  }
  .hero--intro .hero-copy {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .hero--intro .hero-ctas {
    position: absolute;
    right: clamp(20px, 4vw, 64px);
    bottom: clamp(16px, 3vw, 40px);
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 10px;
    transform: none;
    width: auto;
    margin: 0;
    pointer-events: auto;
  }
  .hero--intro .btn-secondary-on-dark,
  .hero--intro .btn-secondary {
    color: var(--ink);
    background: rgba(255, 255, 255, .94);
    border-color: var(--hairline-strong);
    text-shadow: none;
  }
  .hero--intro .hero-ctas .btn {
    min-height: 48px;
    padding: 12px 18px;
    font-size: 15px;
    white-space: nowrap;
    box-shadow: 0 2px 12px rgba(0, 0, 0, .12);
  }
  .hero--intro .hero-video-toggle {
    position: absolute;
    top: 12px;
    right: 16px;
    bottom: auto;
    width: 44px;
    height: 44px;
    min-height: 44px;
    margin: 0;
    padding: 0;
    font-size: 16px;
    line-height: 1;
    color: #fff;
    background: rgba(25, 23, 20, .4);
    border-color: rgba(255, 255, 255, .45);
    pointer-events: auto;
  }
  @media (max-width: 760px) {
    .hero--intro .hero-ctas { right: 16px; bottom: 16px; gap: 8px; }
    .hero--intro .hero-ctas .btn { width: auto; min-height: 44px; padding: 10px 14px; font-size: 13px; gap: 6px; }
    .hero--intro .hero-ctas .btn svg { width: 17px; height: 17px; }
    .hero-film::after { height: 60%; }
  }

  .hero-brand-story {
    position: absolute;
    z-index: 1;
    left: clamp(20px, 4vw, 64px);
    bottom: clamp(28px, 4vw, 56px);
    color: #fff;
    font-family: 'Gowun Batang', serif;
    text-shadow: 0 1px 8px #0006;
    pointer-events: none;
  }
  .hero--intro .hero-brand-story p {
    margin: 0 0 12px;
    font-size: clamp(18px, 2vw, 30px);
    line-height: 1.8;
    word-break: keep-all;
  }
  .hero-brand-story span { font-size: clamp(13px, 1.2vw, 18px); opacity: .85; }
  .hero-film::after { height: 45%; background: linear-gradient(transparent, rgba(25, 23, 20, .38)); }
  @media (max-width: 760px) {
    .hero-brand-story { left: 16px; right: 16px; bottom: 74px; }
    .hero--intro .hero-brand-story p { font-size: clamp(12px, 3.2vw, 18px); line-height: 1.6; margin-bottom: 4px; }
    .hero-brand-story span { font-size: 11px; }
    .hero-film::after { height: 75%; }
  }
</style>

<script>
  const video = document.querySelector<HTMLVideoElement>('.hero-video');
  const toggle = document.querySelector<HTMLButtonElement>('.hero-video-toggle');
  const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const mobile = window.matchMedia('(max-width: 640px)');
  const floatingCall = document.querySelector<HTMLElement>('.mfloat');
  if (video && toggle) {
    const syncLabel = () => {
      const label = video.paused ? '영상 재생' : '영상 일시정지';
      toggle.textContent = video.paused ? '▶' : 'Ⅱ';
      toggle.setAttribute('aria-label', label);
      toggle.title = label;
    };
    const respectMotion = () => {
      if (motion.matches) { video.removeAttribute('autoplay'); video.pause(); video.currentTime = 0; }
      syncLabel();
    };
    respectMotion();
    motion.addEventListener('change', respectMotion);
    mobile.addEventListener('change', respectMotion);
    if (floatingCall && 'IntersectionObserver' in window) {
      const hero = document.querySelector<HTMLElement>('.hero');
      if (hero) new IntersectionObserver(([entry]) => {
        floatingCall.style.visibility = entry.isIntersecting && mobile.matches ? 'hidden' : 'visible';
      }, { threshold: 0.08 }).observe(hero);
    }
    video.addEventListener('play', syncLabel);
    video.addEventListener('pause', syncLabel);
    toggle.hidden = false;
    toggle.addEventListener('click', async () => {
      if (video.paused) {
        try { await video.play(); } catch { syncLabel(); }
      } else {
        video.pause();
      }
    });
  }
</script>

<style>
  .hero-video-toggle {
    position: absolute;
    right: 16px;
    bottom: 16px;
    min-height: 44px;
    padding: 10px 16px;
    border: 1px solid var(--hairline);
    border-radius: 999px;
    background: var(--surface-soft);
    color: var(--ink-deep);
    font: inherit;
    font-size: 13px;
    cursor: pointer;
  }
  .hero-video-toggle:focus-visible {
    outline: 3px solid var(--primary-deep);
    outline-offset: 3px;
  }
</style>
