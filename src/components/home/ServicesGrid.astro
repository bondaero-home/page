---
import { css } from '../../lib/css';
import Icon from '../Icon.astro';
import MidIcon from './MidIcon.astro';
import FabricSwatch from './FabricSwatch.astro';

const items = [
  { kind: "blackout", title: "암막커튼", desc: "빛을 완벽히 차단해 깊은 잠을 돕습니다", room: "침실 · 안방" },
  { kind: "sheer",    title: "쉬폰커튼", desc: "자연 채광을 부드럽게 들이는 차르르한 느낌", room: "거실 · 다이닝룸" },
  { kind: "double",   title: "이중커튼 (암막+쉬폰)", desc: "낮과 밤의 채광을 자유롭게 조절합니다", room: "거실 · 침실" },
  { kind: "combi",    title: "콤비블라인드", desc: "빛 조절이 세밀하고 인테리어가 깔끔해집니다", room: "사무실 · 거실" },
  { kind: "wood",     title: "우드블라인드", desc: "원목 질감으로 고급스러운 분위기를 더합니다", room: "서재 · 카페" },
  { kind: "roll",     title: "롤스크린", desc: "공간을 차지하지 않아 좁은 공간에 알맞습니다", room: "주방 · 욕실" },
];
---
<section class="block" id="services">
  <div class="container">
    <div style={css({ marginBottom: 48 })}>
      <div class="section-eyebrow">서비스 한눈에 보기</div>
      <h2 class="section-title">이런 제품을 만들어 드립니다</h2>
      <p class="section-lede" style={css({ marginTop: 12 })}>
        모든 제품은 댁의 창문에 맞춰 직접 제작합니다. 매장에서 원단을 직접 보시고 결정하세요.
      </p>
    </div>
    <div class="grid grid-3">
      {items.map((it) => (
        <div class="svc">
          <div class="thumb"><FabricSwatch kind={it.kind} /></div>
          <div class="body">
            <h4>{it.title}</h4>
            <p>{it.desc}</p>
            <div class="room" style={css({ display: "inline-flex", alignItems: "center", gap: 5 })}><span style={css({ color: "var(--primary)", display: "inline-flex" })}><MidIcon name="pin" size={14} stroke={2} /></span> {it.room}</div>
          </div>
        </div>
      ))}
    </div>
    <div style={css({ marginTop: 36, textAlign: "center" })}>
      <a class="btn-link t-body-m" href="/서비스" style={css({ display: "inline-flex", alignItems: "center", gap: 6 })}>
        전체 서비스 자세히 보기 <Icon name="arrow-right" size={14} />
      </a>
    </div>
  </div>
</section>
