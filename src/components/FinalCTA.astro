---
import { business } from '../data/business';
import Icon from './Icon.astro';

// 재사용 CTA 섹션. 페이지별 문구는 props로 주입(기본값 = 홈).
interface Props {
  titleHtml?: string;
  leadHtml?: string;
  primaryLabel?: string;
  secondaryLabel?: string;
}
const {
  titleHtml = '거실 커튼, 어떤 게 좋을지<br />함께 고민해 드립니다',
  leadHtml = '전화 한 통이면 대략적인 가격대와 진행 일정을 바로 안내해 드립니다.<br />청주 오창·오송 지역, 방문 실측 무료입니다.',
  primaryLabel = '지금 전화 상담하기',
  secondaryLabel = '매장 방문하기',
} = Astro.props;
const { phone, storePhone } = business;
---
<section class="block">
  <div class="container">
    <div class="final-cta">
      <div style={{ position: 'relative', zIndex: 2 }}>
        <h2 set:html={titleHtml}></h2>
        <p set:html={leadHtml}></p>
        <div style={{ display: 'flex', gap: '12px', flexWrap: 'wrap', justifyContent: 'center' }}>
          <a class="btn btn-primary btn-xl" href={`tel:${phone}`}>
            <Icon name="phone" size={18} /> {primaryLabel}
          </a>
          <a class="btn btn-secondary-on-dark btn-xl" href={business.mapUrl} target="_blank" rel="noopener">
            <Icon name="pin" size={18} /> {secondaryLabel}
          </a>
        </div>
        <div style={{ marginTop: '22px', fontSize: '14px', color: 'var(--charcoal)', display: 'flex', flexWrap: 'wrap', justifyContent: 'center', columnGap: '14px', rowGap: '4px' }}>
          <span><span style={{ color: 'var(--steel)' }}>매장</span> {storePhone}</span>
          <span><span style={{ color: 'var(--steel)' }}>휴대폰</span> {phone}</span>
          <span style={{ color: 'var(--steel)' }}>평일 10:30 – 19:00</span>
        </div>
      </div>
    </div>
  </div>
</section>
