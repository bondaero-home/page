---
// 카테고리 블록 — 네이티브 <details>/<summary> 아코디언(JS 없음).
import { css } from '../../lib/css';
import Chev from './Chev.astro';
import type { FaqCategory } from '../../data/faq';

interface Props {
  cat: FaqCategory;
  startOpen: boolean;
}
const { cat, startOpen } = Astro.props;
---
<section id={cat.id} style={css({ scrollMarginTop: 90, marginBottom: 56 })}>
  <div style={css({ marginBottom: 24, paddingBottom: 16, borderBottom: "2px solid var(--ink-deep)" })}>
    <h2 style={css({ fontSize: "clamp(24px, 3.4vw, 30px)", fontWeight: 700, letterSpacing: "-0.6px", margin: "0 0 6px", color: "var(--ink-deep)" })}>{cat.title}</h2>
    <p style={css({ margin: 0, fontSize: 15, color: "var(--steel)" })}>{cat.desc}</p>
  </div>
  <div>
    {cat.items.map((it, i) => (
      <details class="faq" open={startOpen && i === 0 ? true : undefined}>
        <summary>
          <h5 style={css({ fontSize: 18 })}>{it.q}</h5>
          <span class="chev"><Chev /></span>
        </summary>
        <div class="ans" style={css({ fontSize: 16, lineHeight: 1.8 })} set:html={it.a}></div>
      </details>
    ))}
  </div>
</section>
